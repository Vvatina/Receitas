<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F5FF"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="#4E342E"
            android:contentDescription="Voltar"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Novo Livro de Receitas"
            android:textSize="40dp"
            android:fontFamily="@font/tangerine_regular"
            android:textStyle="bold"
            android:textColor="#4E342E"
            android:gravity="center"/>

        <View
            android:layout_width="48dp"
            android:layout_height="48dp"/>
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:background="#BAB095"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="32dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nome da Coleção"
        android:fontFamily="@font/tangerine_regular"
        android:textColor="#8D6E63"
        android:textSize="35dp"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/editCollectionName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ex: Natal 2026, Receitas da Avó..."
        android:textColorHint="#BCAAA4"
        android:textColor="#4E342E"
        android:textSize="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:backgroundTint="#BAB095"
        android:inputType="textCapSentences"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Poderás partilhar esta coleção com a tua família ou amigos depois de a criares."
        android:textColor="#A1887F"
        android:textSize="16dp"
        android:layout_marginTop="16dp"
        android:gravity="center"/>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

    <Button
        android:id="@+id/btnSaveCollection"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Criar Coleção"
        android:textSize="20dp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:backgroundTint="#BAB095"
        app:cornerRadius="12dp"/>

</LinearLayout>