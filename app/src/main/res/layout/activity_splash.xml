<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/papel_fundo">
    <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imgLogoSplash"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:src="@drawable/logo" />

    <TextView
        android:id="@+id/tvNomeAppSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/tangerine_regular"
        android:text="Receita de Bolso"
        android:textColor="@color/text_primary"
        android:textSize="56sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSloganSplash"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/tangerine_regular"
        android:text="todas suas receitas num lugar só."
        android:textColor="@color/text_secondary"
        android:textSize="28sp" />

</LinearLayout>

</RelativeLayout>