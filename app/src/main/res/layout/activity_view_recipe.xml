<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/papel_fundo"
    android:fillViewport="true">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardCornerRadius="8dp"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/papel_fundo"
            android:padding="24dp">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="4dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="24dp">

                <ImageView
                    android:id="@+id/imgMainRecipe"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:scaleType="centerCrop"
                    android:background="#EEE"
                    android:padding="8dp"
                    android:contentDescription="Imagem da receita" />
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="8dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Manter ecrã ligado"
                    android:fontFamily="@font/tangerine_regular"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_color" />

                <Switch
                    android:id="@+id/switchModoCozinha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:theme="@style/EstiloSwitchMarrom" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvRecipeName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome da Receita"
                android:textSize="52sp"
                android:textStyle="bold"
                android:fontFamily="@font/tangerine_regular"
                android:textColor="@color/ink_color"
                android:gravity="center"
                android:lineSpacingExtra="-8dp"
                android:layout_marginBottom="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center"
                android:layout_marginBottom="24dp">

                <TextView
                    android:text="Categoria: "
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/tangerine_regular"
                    android:textSize="28sp"
                    android:textColor="#8D6E63"/>

                <TextView
                    android:id="@+id/tvRecipeType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sobremesa"
                    android:fontFamily="@font/tangerine_regular"
                    android:textStyle="bold"
                    android:textSize="28sp"
                    android:textColor="@color/ink_color"/>
            </LinearLayout>

            <View
                android:layout_width="150dp"
                android:layout_height="2dp"
                android:layout_gravity="center_horizontal"
                android:background="#BAB095"
                android:layout_marginBottom="24dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ingredientes"
                android:fontFamily="@font/tangerine_regular"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/ink_color"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvRecipeIngredients"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3 ovos\n2 xícaras de farinha de trigo\n1 xícara de açúcar"
                android:fontFamily="@font/tangerine_regular"
                android:textSize="28sp"
                android:textColor="@color/ink_color"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="24dp"
                android:paddingStart="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <View
                    android:layout_width="40dp"
                    android:layout_height="1dp"
                    android:background="#BAB095"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Modo de Preparo"
                    android:fontFamily="@font/tangerine_regular"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink_color"
                    android:layout_marginHorizontal="12dp"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#BAB095"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layoutStepsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="32dp" />

            <Button
                android:id="@+id/btnExportPDF"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Exportar para PDF"
                android:fontFamily="@font/tangerine_regular"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_vintage_button"
                android:elevation="6dp"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>
</ScrollView>